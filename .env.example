# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` — it is git-ignored.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql+psycopg://vacation_user:vacation_password@localhost:5432/vacation_planner

# --- JWT authentication ---
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
